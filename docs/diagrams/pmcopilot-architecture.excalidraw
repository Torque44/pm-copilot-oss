      "updated": 1715520000000,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 5,
      "text": "🚫 NO FABRICATION\n\nUpstream agents build a citation registry from real tool output\nfirst. The LLM only references by index — invented IDs get\nstripped before render. Sentiment URL provenance enforced via\nGrok's actual citations[] array.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🚫 NO FABRICATION\n\nUpstream agents build a citation registry from real tool output\nfirst. The LLM only references by index — invented IDs get\nstripped before render. Sentiment URL provenance enforced via\nGrok's actual citations[] array.",
      "lineHeight": 1.25,
      "baseline": 14
    },

